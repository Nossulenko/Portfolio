{
  "extends": [
    "standard",
    "standard-react"
  ],

  "parser": "babel-eslint",

  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },

  "env": {
    "es6": true,
    "browser": true,
    "node": true
  },

  "rules": {
    "semi": ["error", "always"]
  },

  "overrides": [
    {
      "files": ["src/components/Starmap/**/*.js"],
      "rules": {
        "react/no-unknown-property": "off"
      }
    }
  ]
}
